<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analytics & Reports – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="dashboard-body">

<%- include('../partials/admin-sidebar', { activePage: 'reports' }) %>

<div class="main-content" id="mainContent">
    <div class="topbar">
        <div class="topbar-left">
            <h1><i class="fas fa-file-invoice" style="color: var(--secondary);"></i> Analytics & Reports</h1>
            <p>Comprehensive maintenance statistics, category breakdown, and official audit exports</p>
        </div>
        <div class="topbar-right" style="display: flex; gap: 0.75rem;">
            <a href="/admin/export/csv" class="btn btn-secondary"><i class="fas fa-file-csv"></i> Download CSV</a>
            <a href="/admin/export/pdf" target="_blank" class="btn btn-primary"><i class="fas fa-file-pdf"></i> Print / Export PDF Audit</a>
        </div>
    </div>

    <!-- Overview Stats -->
    <div class="stats-grid-7">
        <div class="stat-card stat-total">
            <div class="stat-icon"><i class="fas fa-file-alt"></i></div>
            <div class="stat-info">
                <h3><%= stats.total || 0 %></h3>
                <p>Total Complaints</p>
            </div>
        </div>
        <div class="stat-card stat-pending">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-info">
                <h3><%= stats.pending || 0 %></h3>
                <p>Pending</p>
            </div>
        </div>
        <div class="stat-card stat-progress">
            <div class="stat-icon"><i class="fas fa-tools"></i></div>
            <div class="stat-info">
                <h3><%= stats.in_progress || 0 %></h3>
                <p>In Progress</p>
            </div>
        </div>
        <div class="stat-card stat-resolved">
            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
            <div class="stat-info">
                <h3><%= stats.resolved || 0 %></h3>
                <p>Resolved</p>
            </div>
        </div>
        <div class="stat-card stat-rejected">
            <div class="stat-icon"><i class="fas fa-times-circle"></i></div>
            <div class="stat-info">
                <h3><%= stats.rejected || 0 %></h3>
                <p>Rejected</p>
            </div>
        </div>
    </div>

    <!-- Resolution Rate -->
    <% if (stats.total > 0) { %>
    <% const resPercent = Math.round((stats.resolved / stats.total) * 100); %>
    <div class="table-card" style="padding: 1.5rem; margin-bottom: 1.5rem;">
        <div class="resolution-label">
            <span>Complaints Overall Resolution Rate</span>
            <span class="resolution-percent"><%= resPercent %>%</span>
        </div>
        <div class="resolution-bar-bg">
            <div class="resolution-bar" style="<%= 'width: ' + resPercent + '%' %>"></div>
        </div>
    </div>
    <% } %>

    <!-- Grid Reports: Category & Department (Flat/Block) -->
    <div class="reports-grid">
        <!-- Category Breakdown -->
        <div class="table-card">
            <div class="table-header">
                <h3><i class="fas fa-tags" style="color: var(--primary); margin-right: 6px;"></i> By Category</h3>
            </div>
            <div style="overflow-x: auto;">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Total</th>
                            <th>Resolved</th>
                            <th>Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% byCategory.forEach(cat => { %>
                        <% const catRate = cat.count > 0 ? Math.round((cat.resolved / cat.count) * 100) : 0; %>
                        <tr>
                            <td><strong><%= cat.category %></strong></td>
                            <td style="font-weight: 700;"><%= cat.count %></td>
                            <td style="color: var(--secondary-hover); font-weight: 700;"><%= cat.resolved %></td>
                            <td>
                                <div class="mini-bar-wrap">
                                    <div class="mini-bar mini-bar-green" style="<%= 'width: ' + catRate + 'px' %>"></div>
                                    <span><%= catRate %>%</span>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Location Breakdown -->
        <div class="table-card">
            <div class="table-header">
                <h3><i class="fas fa-building" style="color: var(--primary); margin-right: 6px;"></i> By Flat / Block Location</h3>
            </div>
            <div style="overflow-x: auto;">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Flat / Block</th>
                            <th>Total</th>
                            <th>Resolved</th>
                            <th>Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% byDepartment.forEach(dep => { %>
                        <% const depRate = dep.count > 0 ? Math.round((dep.resolved / dep.count) * 100) : 0; %>
                        <tr>
                            <td><strong><%= dep.department %></strong></td>
                            <td style="font-weight: 700;"><%= dep.count %></td>
                            <td style="color: var(--secondary-hover); font-weight: 700;"><%= dep.resolved %></td>
                            <td>
                                <div class="mini-bar-wrap">
                                    <div class="mini-bar mini-bar-blue" style="<%= 'width: ' + depRate + 'px' %>"></div>
                                    <span><%= depRate %>%</span>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="/js/main.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>

