<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Society Manager Dashboard – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="dashboard-body">

<%- include('../partials/admin-sidebar', { activePage: 'dashboard' }) %>

<div class="main-content" id="mainContent">
    <div class="topbar">
        <div class="topbar-left">
            <h1><i class="fas fa-chart-line" style="color: var(--secondary);"></i> Society Manager Control Panel</h1>
            <p>Welcome, <strong><%= user.full_name %></strong> — Apartment Complaints & Maintenance Overview</p>
        </div>
        <div class="topbar-right">
            <a href="/admin/complaints" class="btn btn-primary"><i class="fas fa-tasks"></i> Manage Complaints</a>
            <a href="/admin/export/csv" class="btn btn-secondary"><i class="fas fa-file-csv"></i> Export CSV</a>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #D1FAE5; color: #059669; border: 1px solid #A7F3D0; padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <i class="fas fa-check-circle" style="margin-right: 6px;"></i> <%= success %>
    </div>
    <% } %>

    <!-- 7 Dashboard Stat Cards Required by Specification -->
    <div class="stats-grid-7">
        <!-- 1. Total Complaints -->
        <div class="stat-card stat-total">
            <div class="stat-icon"><i class="fas fa-file-alt"></i></div>
            <div class="stat-info">
                <h3><%= stats.total || 0 %></h3>
                <p>Total Complaints</p>
            </div>
        </div>

        <!-- 2. Pending -->
        <div class="stat-card stat-pending">
            <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
            <div class="stat-info">
                <h3><%= stats.pending || 0 %></h3>
                <p>Pending</p>
            </div>
        </div>

        <!-- 3. In Progress -->
        <div class="stat-card stat-progress">
            <div class="stat-icon"><i class="fas fa-tools"></i></div>
            <div class="stat-info">
                <h3><%= stats.in_progress || 0 %></h3>
                <p>In Progress</p>
            </div>
        </div>

        <!-- 4. Resolved -->
        <div class="stat-card stat-resolved">
            <div class="stat-icon"><i class="fas fa-check-double"></i></div>
            <div class="stat-info">
                <h3><%= stats.resolved || 0 %></h3>
                <p>Resolved</p>
            </div>
        </div>

        <!-- 5. Residents -->
        <div class="stat-card stat-residents">
            <div class="stat-icon"><i class="fas fa-user-friends"></i></div>
            <div class="stat-info">
                <h3><%= stats.totalUsers || 0 %></h3>
                <p>Residents</p>
            </div>
        </div>

        <!-- 6. Maintenance Requests -->
        <div class="stat-card stat-requests">
            <div class="stat-icon"><i class="fas fa-wrench"></i></div>
            <div class="stat-info">
                <h3><%= stats.maintenanceRequests || 0 %></h3>
                <p>Maintenance Requests</p>
            </div>
        </div>

        <!-- 7. Announcements -->
        <div class="stat-card stat-announcements">
            <div class="stat-icon"><i class="fas fa-bullhorn"></i></div>
            <div class="stat-info">
                <h3><%= stats.announcementsCount || 3 %></h3>
                <p>Announcements</p>
            </div>
        </div>
    </div>

    <!-- Recent Activity & Charts -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
        
        <!-- Recent Complaints -->
        <div class="table-card" style="margin-bottom: 0;">
            <div class="table-header">
                <h3><i class="fas fa-list-alt" style="color: var(--primary); margin-right: 8px;"></i> Recent Residential Tickets</h3>
                <a href="/admin/complaints" class="btn btn-light" style="padding: 0.35rem 0.8rem; font-size: 0.82rem;">View All <i class="fas fa-arrow-right"></i></a>
            </div>
            
            <div style="overflow-x: auto;">
                <table class="custom-table">
                    <thead>
                        <tr>
                            <th>Ticket ID</th>
                            <th>Title</th>
                            <th>Resident</th>
                            <th>Flat / Block</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentComplaints.forEach(c => { %>
                        <tr>
                            <td><strong style="color: var(--primary);"><%= c.complaint_id %></strong></td>
                            <td><strong><%= c.title %></strong></td>
                            <td><%= c.user_name %></td>
                            <td><%= c.department %></td>
                            <td><span class="badge badge-priority-<%= c.priority.toLowerCase() %>"><%= c.priority %></span></td>
                            <td><span class="badge badge-<%= c.status.toLowerCase().replace(' ', '-') %>"><%= c.status %></span></td>
                            <td>
                                <a href="/admin/complaints/<%= c.id %>" class="btn btn-light" style="padding: 0.25rem 0.6rem; font-size: 0.78rem;">
                                    <i class="fas fa-edit"></i> Review
                                </a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Category Distribution Chart -->
        <div class="table-card" style="padding: 1.25rem; margin-bottom: 0;">
            <h3 style="font-size: 1.05rem; font-weight: 800; margin-bottom: 1rem;"><i class="fas fa-chart-pie" style="color: var(--secondary); margin-right: 6px;"></i> Issues by Category</h3>
            <div style="position: relative; height: 260px; width: 100%;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>

    </div>

</div>

<script src="/js/main.js"></script>
<script src="/js/admin.js"></script>
<script id="categoryDataJson" type="application/json">
    <%- JSON.stringify(byCategory || []) %>
</script>
<script>
    const categoryData = JSON.parse(document.getElementById('categoryDataJson').textContent || '[]');
    if (categoryData.length > 0 && document.getElementById('categoryChart')) {
        const catLabels = categoryData.map(d => d.category);
        const catCounts = categoryData.map(d => d.count);
        new Chart(document.getElementById('categoryChart'), {
            type: 'doughnut',
            data: {
                labels: catLabels,
                datasets: [{
                    data: catCounts,
                    backgroundColor: ['#1E3A8A', '#10B981', '#F59E0B', '#3B82F6', '#EF4444', '#8B5CF6', '#EC4899', '#14B8A6']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } }
            }
        });
    }
</script>
</body>
</html>

