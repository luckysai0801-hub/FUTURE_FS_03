<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Ticket – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="stylesheet" href="/css/complaints.css">
</head>
<body class="dashboard-body">

<%- include('../partials/admin-sidebar', { activePage: 'complaints' }) %>

<div class="main-content" id="mainContent">
    <div class="topbar">
        <div class="topbar-left">
            <h1><i class="fas fa-edit" style="color: var(--secondary);"></i> Ticket Management: <%= complaint.complaint_id %></h1>
            <p>Review resident request, assign maintenance staff, and update ticket status</p>
        </div>
        <div class="topbar-right">
            <a href="/admin/complaints" class="btn btn-light"><i class="fas fa-arrow-left"></i> All Complaints</a>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #D1FAE5; color: #059669; border: 1px solid #A7F3D0; padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <i class="fas fa-check-circle" style="margin-right: 6px;"></i> <%= success %>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div style="background: #FEE2E2; color: #DC2626; padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <i class="fas fa-exclamation-circle" style="margin-right: 6px;"></i> <%= error %>
    </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
        
        <div>
            <!-- Ticket Info Header Card -->
            <div class="table-card" style="padding: 2rem; margin-bottom: 2rem;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 1rem;">
                    <div>
                        <span style="font-size: 0.85rem; font-weight: 700; color: var(--primary);"><%= complaint.complaint_id %></span>
                        <h2 style="font-size: 1.5rem; font-weight: 800; margin-top: 0.25rem;"><%= complaint.title %></h2>
                    </div>
                    <span class="badge badge-<%= complaint.status.toLowerCase().replace(' ', '-') %>" style="font-size: 0.95rem; padding: 6px 16px;">
                        <%= complaint.status %>
                    </span>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem; background: var(--bg); padding: 1.25rem; border-radius: var(--radius-sm);">
                    <div>
                        <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Resident Name</span>
                        <strong style="color: var(--text-main);"><%= complaint.user_name %></strong>
                    </div>
                    <div>
                        <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Resident Email / Mobile</span>
                        <span style="color: var(--text-body); font-size: 0.85rem;"><%= complaint.user_email || 'N/A' %> &bull; <%= complaint.user_phone %></span>
                    </div>
                    <div>
                        <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Flat / Location</span>
                        <strong style="color: var(--text-main);"><%= complaint.department %></strong>
                    </div>
                    <div>
                        <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Category</span>
                        <span style="font-weight: 700;"><%= complaint.category %></span>
                    </div>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <h4 style="font-size: 1rem; font-weight: 800; margin-bottom: 0.5rem;">Resident Issue Description</h4>
                    <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text-body); background: #FFFFFF; padding: 1rem; border: 1px solid var(--border-light); border-radius: var(--radius-sm);">
                        <%= complaint.description %>
                    </p>
                </div>

                <% if (complaint.image_path) { %>
                <div style="margin-bottom: 1.5rem;">
                    <h4 style="font-size: 1rem; font-weight: 800; margin-bottom: 0.5rem;">Attached Photo Proof</h4>
                    <img src="<%= complaint.image_path %>" alt="Attached Proof" style="max-height: 250px; border-radius: var(--radius-sm); border: 1px solid var(--border-light); cursor: pointer;" onclick="window.open(this.src)" />
                </div>
                <% } %>
            </div>

            <!-- Update Ticket Status Form -->
            <div class="table-card" style="padding: 2rem; margin-bottom: 2rem;">
                <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
                    <i class="fas fa-sync-alt" style="color: var(--primary); margin-right: 6px;"></i> Update Complaint Status
                </h3>
                <form action="/admin/complaints/<%= complaint.id %>/update-status" method="POST" id="statusForm">
                    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 1rem;" class="form-grid">
                        <div class="form-group">
                            <label for="new_status">Select Status *</label>
                            <select id="new_status" name="new_status" class="form-control" required>
                                <% ['Pending','In Progress','Resolved','Rejected'].forEach(s => { %>
                                <option value="<%= s %>" <%= complaint.status === s ? 'selected' : '' %>><%= s %></option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="remarks">Status Remarks for Resident</label>
                            <input type="text" id="remarks" name="remarks" class="form-control" placeholder="e.g. Technician dispatched / Issue fixed successfully" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-check-circle"></i> Save & Broadcast Status Change
                    </button>
                </form>
            </div>

            <!-- Assign Staff Form -->
            <div class="table-card" style="padding: 2rem;">
                <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
                    <i class="fas fa-user-cog" style="color: var(--primary); margin-right: 6px;"></i> Assign Maintenance Staff & Official Notes
                </h3>
                <form action="/admin/complaints/<%= complaint.id %>/update-details" method="POST">
                    <div class="form-group">
                        <label for="assigned_to">Assigned Technician / Maintenance Vendor</label>
                        <input type="text" id="assigned_to" name="assigned_to" class="form-control" value="<%= complaint.assigned_to || '' %>" placeholder="e.g. Senior Electrician Ramesh / Otis Lift Team" />
                    </div>

                    <div class="form-group">
                        <label for="admin_remarks">Official Management Remarks</label>
                        <textarea id="admin_remarks" name="admin_remarks" class="form-control" rows="3" placeholder="Official remarks visible to resident in details page..."><%= complaint.admin_remarks || '' %></textarea>
                    </div>

                    <button type="submit" class="btn btn-secondary">
                        <i class="fas fa-save"></i> Save Staff Assignment & Remarks
                    </button>
                </form>
            </div>
        </div>

        <!-- Right Audit Sidebar -->
        <div>
            <div class="table-card" style="padding: 1.5rem;">
                <h3 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1.25rem;"><i class="fas fa-history" style="color: var(--primary); margin-right: 6px;"></i> Audit History</h3>
                
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <div class="timeline-time"><%= new Date(complaint.created_at).toLocaleString('en-IN') %></div>
                            <div class="timeline-title">Submitted by Resident</div>
                            <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;"><%= complaint.user_name %></p>
                        </div>
                    </div>

                    <% if (updates && updates.length > 0) { %>
                        <% updates.forEach(u => { %>
                        <div class="timeline-item">
                            <div class="timeline-dot" style="border-color: var(--secondary);"></div>
                            <div class="timeline-content">
                                <div class="timeline-time"><%= new Date(u.updated_at).toLocaleString('en-IN') %></div>
                                <div class="timeline-title">
                                    <span class="badge badge-<%= (u.new_status || 'Pending').toLowerCase().replace(' ', '-') %>"><%= u.new_status %></span>
                                </div>
                                <% if (u.remarks) { %>
                                <p style="font-size: 0.82rem; color: var(--text-body); margin-top: 4px;"><%= u.remarks %></p>
                                <% } %>
                                <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-top: 4px;">By <%= u.updated_by_name %></span>
                            </div>
                        </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="/js/main.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
