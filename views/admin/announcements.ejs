<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Announcements – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="dashboard-body">

<%- include('../partials/admin-sidebar', { activePage: 'announcements' }) %>

<div class="main-content" id="mainContent">
    <div class="topbar">
        <div class="topbar-left">
            <h1><i class="fas fa-bullhorn" style="color: var(--secondary);"></i> Society Announcements & Notices</h1>
            <p>Broadcast alerts, maintenance schedules, and society meeting notices to all residents</p>
        </div>
        <div class="topbar-right">
            <a href="/admin/dashboard" class="btn btn-light"><i class="fas fa-arrow-left"></i> Dashboard</a>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #D1FAE5; color: #059669; border: 1px solid #A7F3D0; padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <i class="fas fa-check-circle" style="margin-right: 6px;"></i> <%= success %>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <i class="fas fa-exclamation-circle" style="margin-right: 6px;"></i> <%= error %>
    </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem;">
        
        <!-- Post Announcement Form -->
        <div class="table-card" style="padding: 2rem;">
            <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
                <i class="fas fa-plus-circle" style="color: var(--primary); margin-right: 6px;"></i> Broadcast New Notice
            </h3>
            <form action="/admin/announcements" method="POST">
                <div class="form-group">
                    <label for="title">Notice Title *</label>
                    <input type="text" id="title" name="title" class="form-control" required placeholder="e.g. Scheduled Water Tank Cleaning" />
                </div>

                <div class="form-group">
                    <label for="category">Notice Category</label>
                    <select id="category" name="category" class="form-control">
                        <option value="General Notice">General Notice</option>
                        <option value="Maintenance Alert">Maintenance Alert</option>
                        <option value="Sanitation">Sanitation</option>
                        <option value="Security Alert">Security Alert</option>
                        <option value="Society Meeting">Society Meeting</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="priority">Priority Level</label>
                    <select id="priority" name="priority" class="form-control">
                        <option value="Low">Low Priority</option>
                        <option value="Medium" selected>Medium Priority</option>
                        <option value="High">High Priority</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="content">Announcement Content *</label>
                    <textarea id="content" name="content" class="form-control" rows="5" required placeholder="Describe the announcement details..."></textarea>
                </div>

                <button type="submit" class="btn btn-primary" style="width: 100%;">
                    <i class="fas fa-bullhorn"></i> Broadcast Announcement
                </button>
            </form>
        </div>

        <!-- Announcements List -->
        <div>
            <div class="table-card">
                <div class="table-header">
                    <h3><i class="fas fa-list" style="color: var(--primary); margin-right: 8px;"></i> Broadcast History (<%= announcements.length %>)</h3>
                </div>

                <% if (announcements.length === 0) { %>
                <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
                    <i class="fas fa-bullhorn" style="font-size: 3rem; margin-bottom: 1rem; color: var(--border-light);"></i>
                    <h4>No active announcements</h4>
                </div>
                <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 1rem; padding: 1.5rem;">
                    <% announcements.forEach(a => { %>
                    <div style="background: var(--bg); border: 1px solid var(--border-light); padding: 1.25rem; border-radius: var(--radius-sm); border-left: 4px solid <%= a.priority === 'High' ? '#EF4444' : (a.priority === 'Medium' ? '#3B82F6' : '#10B981') %>;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
                            <div>
                                <span class="badge" style="background: var(--primary-light); color: var(--primary); font-size: 0.75rem;"><%= a.category %></span>
                                <h4 style="font-size: 1.1rem; font-weight: 800; margin-top: 4px; color: var(--text-main);"><%= a.title %></h4>
                            </div>
                            <form action="/admin/announcements/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Delete this announcement?');">
                                <button type="submit" class="btn btn-light" style="color: #DC2626; padding: 0.25rem 0.5rem; font-size: 0.8rem;">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            </form>
                        </div>
                        <p style="font-size: 0.92rem; color: var(--text-body); line-height: 1.6; margin-bottom: 0.75rem;">
                            <%= a.content %>
                        </p>
                        <div style="font-size: 0.78rem; color: var(--text-muted); display: flex; justify-content: space-between;">
                            <span>Posted by <%= a.author_name || 'Society Manager' %></span>
                            <span><%= new Date(a.created_at).toLocaleString('en-IN') %></span>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } %>
            </div>
        </div>

    </div>
</div>

<script src="/js/main.js"></script>
<script src="/js/admin.js"></script>
</body>
</html>
