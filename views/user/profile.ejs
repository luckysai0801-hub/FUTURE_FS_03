<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resident Profile – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="dashboard-body">

<%- include('../partials/sidebar', { activePage: 'profile' }) %>

<div class="main-content" id="mainContent">
    <div class="topbar">
        <div class="topbar-left">
            <h1><i class="fas fa-id-card" style="color: var(--primary);"></i> Resident Profile</h1>
            <p>Manage your registered personal details and security settings</p>
        </div>
        <div class="topbar-right">
            <a href="/dashboard" class="btn btn-light"><i class="fas fa-arrow-left"></i> Dashboard</a>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #D1FAE5; color: #059669; border: 1px solid #A7F3D0; padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <i class="fas fa-check-circle" style="margin-right: 6px;"></i> <%= success %>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div style="background: #FEE2E2; color: #DC2626; padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <i class="fas fa-exclamation-circle" style="margin-right: 6px;"></i> <%= error %>
    </div>
    <% } %>

    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem;">
        
        <!-- User Badge Card -->
        <div class="table-card" style="padding: 2rem; text-align: center;">
            <div style="width: 80px; height: 80px; border-radius: 50%; background: var(--primary-light); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin: 0 auto 1.25rem;">
                <i class="fas fa-user-circle"></i>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 0.25rem;"><%= profileUser.full_name %></h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem;"><%= profileUser.email %></p>
            
            <div style="display: inline-block; background: var(--secondary-light); color: var(--secondary-hover); padding: 4px 14px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; text-transform: uppercase;">
                Verified Resident
            </div>
        </div>

        <!-- Profile Edit Forms -->
        <div>
            <!-- Personal Info -->
            <div class="table-card" style="padding: 2rem; margin-bottom: 2rem;">
                <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
                    <i class="fas fa-user-edit" style="color: var(--primary); margin-right: 6px;"></i> Update Personal Information
                </h3>
                <form action="/profile/update" method="POST">
                    <div class="form-group">
                        <label for="full_name">Full Name & Flat Details</label>
                        <input type="text" id="full_name" name="full_name" class="form-control" value="<%= profileUser.full_name %>" required />
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address <span style="color: var(--text-muted); font-weight: normal;">(Read-only)</span></label>
                        <input type="email" id="email" class="form-control" value="<%= profileUser.email %>" disabled />
                    </div>

                    <div class="form-group">
                        <label for="phone">Mobile Phone Number</label>
                        <input type="tel" id="phone" name="phone" class="form-control" value="<%= profileUser.phone || '' %>" placeholder="10-digit phone number" />
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save Profile Info
                    </button>
                </form>
            </div>

            <!-- Password Change -->
            <div class="table-card" style="padding: 2rem;">
                <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem;">
                    <i class="fas fa-key" style="color: var(--primary); margin-right: 6px;"></i> Change Password
                </h3>
                <form action="/profile/change-password" method="POST">
                    <div class="form-group">
                        <label for="current_password">Current Password</label>
                        <input type="password" id="current_password" name="current_password" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label for="new_password">New Password</label>
                        <input type="password" id="new_password" name="new_password" class="form-control" required minlength="6" />
                    </div>

                    <div class="form-group">
                        <label for="confirm_password">Confirm New Password</label>
                        <input type="password" id="confirm_password" name="confirm_password" class="form-control" required minlength="6" />
                    </div>

                    <button type="submit" class="btn btn-secondary">
                        <i class="fas fa-lock"></i> Update Password
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
