<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Track Complaint Status – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/complaints.css">
</head>
<body style="background: var(--bg); min-height: 100vh; display: flex; flex-direction: column;">

<%- include('../partials/navbar') %>

<div class="container" style="padding: 3rem 1.5rem; flex: 1;">
    
    <div style="margin-bottom: 2rem; text-align: center;">
        <h1 style="font-size: 2.2rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem;">
            <i class="fas fa-search-location" style="color: var(--primary); margin-right: 8px;"></i> Track Complaint Status
        </h1>
        <p style="color: var(--text-muted); font-size: 1rem; max-width: 600px; margin: 0 auto;">
            Enter your unique Complaint ID (e.g. CMP-2026-000145) below to inspect real-time maintenance progress.
        </p>
    </div>

    <!-- Flash Messages -->
    <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #D1FAE5; color: #059669; border: 1px solid #A7F3D0; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; max-width: 800px; margin-left: auto; margin-right: auto;">
        <i class="fas fa-check-circle" style="margin-right: 8px;"></i> <%= success %>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; padding: 1rem 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; max-width: 800px; margin-left: auto; margin-right: auto;">
        <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i> <%= error %>
    </div>
    <% } %>

    <!-- Search Form Card -->
    <div class="table-card" style="padding: 2rem; max-width: 700px; margin: 0 auto 2.5rem; background: #FFFFFF;">
        <form action="/track" method="POST" style="display: flex; gap: 1rem; align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 1; min-width: 250px;">
                <label for="complaint_id" style="font-weight: 700; font-size: 0.9rem; color: var(--text-main); display: block; margin-bottom: 6px;">
                    Enter Complaint ID *
                </label>
                <input type="text" id="complaint_id" name="complaint_id" class="form-control" value="<%= searchId || '' %>" placeholder="e.g. CMP-2026-000145" required style="font-size: 1.05rem; padding: 0.75rem 1rem;" />
            </div>
            <button type="submit" class="btn btn-primary" style="padding: 0.75rem 1.8rem; font-size: 1rem;">
                <i class="fas fa-search"></i> Search Status
            </button>
        </form>
    </div>

    <!-- Complaint Search Result -->
    <% if (typeof complaint !== 'undefined' && complaint) { %>
    <div class="table-card" style="max-width: 900px; margin: 0 auto; padding: 2rem; background: #FFFFFF;">
        
        <!-- Header Info -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-light); padding-bottom: 1rem;">
            <div>
                <span style="font-size: 0.9rem; font-weight: 800; color: var(--primary); text-transform: uppercase;">Ticket ID: <%= complaint.complaint_id %></span>
                <h2 style="font-size: 1.5rem; font-weight: 800; margin-top: 0.25rem; color: var(--text-main);"><%= complaint.title %></h2>
            </div>
            <span class="badge badge-<%= complaint.status.toLowerCase().replace(' ', '-') %>" style="font-size: 1rem; padding: 6px 18px;">
                <%= complaint.status %>
            </span>
        </div>

        <!-- 7 Required Metadata Fields -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem; margin-bottom: 1.5rem; background: var(--bg); padding: 1.25rem; border-radius: var(--radius-sm);">
            
            <!-- 1. Complaint Status -->
            <div>
                <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Complaint Status</span>
                <strong style="font-size: 0.95rem; color: var(--primary);"><%= complaint.status %></strong>
            </div>

            <!-- 2. Complaint Category -->
            <div>
                <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Category</span>
                <strong style="font-size: 0.95rem; color: var(--text-main);"><%= complaint.category %></strong>
            </div>

            <!-- 3. Date Submitted -->
            <div>
                <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Date Submitted</span>
                <span style="font-size: 0.9rem; color: var(--text-main); font-weight: 600;">
                    <%= new Date(complaint.created_at).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </span>
            </div>

            <!-- 4. Assigned Maintenance Staff -->
            <div>
                <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Assigned Maintenance Staff</span>
                <% if (complaint.assigned_to) { %>
                    <strong style="color: var(--secondary-hover); font-size: 0.9rem;"><i class="fas fa-user-cog"></i> <%= complaint.assigned_to %></strong>
                <% } else { %>
                    <span style="color: var(--text-muted); font-size: 0.88rem;">Pending Assignment</span>
                <% } %>
            </div>

            <!-- 5. Flat & Resident Info -->
            <div>
                <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Resident / Location</span>
                <span style="font-size: 0.88rem; font-weight: 600;"><%= complaint.resident_name %> (<%= complaint.department %>)</span>
            </div>

            <!-- 6. Priority -->
            <div>
                <span style="font-size: 0.78rem; color: var(--text-muted); font-weight: 700; display: block; text-transform: uppercase;">Priority</span>
                <span class="badge badge-priority-<%= complaint.priority.toLowerCase() %>"><%= complaint.priority %></span>
            </div>
        </div>

        <!-- 3. Complaint Description -->
        <div style="margin-bottom: 1.5rem;">
            <h4 style="font-size: 1rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--text-main);"><i class="fas fa-align-left" style="color: var(--primary); margin-right: 6px;"></i> Complaint Description</h4>
            <p style="font-size: 0.95rem; line-height: 1.6; color: var(--text-body); background: #FFFFFF; padding: 1rem; border: 1px solid var(--border-light); border-radius: var(--radius-sm);">
                <%= complaint.description %>
            </p>
        </div>

        <!-- 7. Resolution Remarks (if resolved) & Management Remarks -->
        <% if (complaint.admin_remarks) { %>
        <div style="margin-bottom: 1.5rem; background: #ECFDF5; border: 1px solid #A7F3D0; padding: 1.25rem; border-radius: var(--radius-sm);">
            <h4 style="font-size: 1rem; font-weight: 800; color: #065F46; margin-bottom: 0.5rem;">
                <i class="fas fa-check-circle" style="margin-right: 6px;"></i> Society Management Remarks / Resolution Details
            </h4>
            <p style="font-size: 0.95rem; color: #047857; margin: 0; line-height: 1.6;">
                <%= complaint.admin_remarks %>
            </p>
        </div>
        <% } %>

        <!-- Image Attachment if present -->
        <% if (complaint.image_path) { %>
        <div style="margin-bottom: 1.5rem;">
            <h4 style="font-size: 1rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--text-main);"><i class="fas fa-image" style="color: var(--primary); margin-right: 6px;"></i> Submitted Photo Proof</h4>
            <img src="<%= complaint.image_path %>" alt="Photo Proof" style="max-height: 250px; border-radius: var(--radius-sm); border: 1px solid var(--border-light); cursor: pointer;" onclick="window.open(this.src)" />
        </div>
        <% } %>

        <!-- 6. Latest Audit Update Timeline -->
        <h4 style="font-size: 1.1rem; font-weight: 800; margin-top: 2rem; margin-bottom: 1rem; border-top: 1px solid var(--border-light); padding-top: 1.5rem; color: var(--text-main);">
            <i class="fas fa-history" style="color: var(--primary); margin-right: 6px;"></i> Progress Audit Timeline
        </h4>

        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-dot"></div>
                <div class="timeline-content">
                    <div class="timeline-time"><%= new Date(complaint.created_at).toLocaleString('en-IN') %></div>
                    <div class="timeline-title">Ticket Created & Registered</div>
                    <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 4px;">Registered by <%= complaint.resident_name %> (<%= complaint.department %>)</p>
                </div>
            </div>

            <% if (updates && updates.length > 0) { %>
                <% updates.forEach(u => { %>
                <div class="timeline-item">
                    <div class="timeline-dot" style="border-color: var(--secondary);"></div>
                    <div class="timeline-content">
                        <div class="timeline-time"><%= new Date(u.updated_at).toLocaleString('en-IN') %></div>
                        <div class="timeline-title">
                            Status updated to <span class="badge badge-<%= (u.new_status || 'Pending').toLowerCase().replace(' ', '-') %>"><%= u.new_status %></span>
                        </div>
                        <% if (u.remarks) { %>
                        <p style="font-size: 0.88rem; color: var(--text-body); margin-top: 4px;"><%= u.remarks %></p>
                        <% } %>
                        <span style="font-size: 0.78rem; color: var(--text-muted); display: block; margin-top: 4px;">By <%= u.updated_by_name %> (Society Manager)</span>
                    </div>
                </div>
                <% }) %>
            <% } else { %>
                <div class="timeline-item">
                    <div class="timeline-dot" style="border-color: var(--warning);"></div>
                    <div class="timeline-content">
                        <div class="timeline-title" style="color: var(--warning);">Awaiting Manager Review</div>
                        <p style="font-size: 0.82rem; color: var(--text-muted); margin-top: 4px;">Your complaint has been queued for technician assignment by the Society Management Office.</p>
                    </div>
                </div>
            <% } %>
        </div>

    </div>
    <% } %>

</div>

<%- include('../partials/footer') %>

<script src="/js/main.js"></script>
</body>
</html>
