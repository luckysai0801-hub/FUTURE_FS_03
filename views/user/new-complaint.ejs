<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Complaint – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/complaints.css">
</head>
<body style="background: var(--bg); min-height: 100vh; display: flex; flex-direction: column;">

<%- include('../partials/navbar') %>

<div class="container" style="padding: 3rem 1.5rem; flex: 1;">
    
    <div style="margin-bottom: 2rem;">
        <h1 style="font-size: 2.2rem; font-weight: 800; color: var(--text-main); margin-bottom: 0.5rem;">
            <i class="fas fa-edit" style="color: var(--primary); margin-right: 8px;"></i> Register Maintenance Complaint
        </h1>
        <p style="color: var(--text-muted); font-size: 1rem;">
            Submit a maintenance request for your apartment unit or common area. No account login required!
        </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
    <div style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <i class="fas fa-exclamation-circle" style="margin-right: 6px;"></i> <%= error %>
    </div>
    <% } %>

    <div class="form-card">
        <div class="card-body">
            <form action="/complaints" method="POST" enctype="multipart/form-data" id="complaintForm">
                
                <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--primary); margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.5rem;">
                    1. Resident & Flat Information
                </h3>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;" class="form-grid">
                    <div class="form-group">
                        <label for="resident_name">Full Name *</label>
                        <input type="text" id="resident_name" name="resident_name" class="form-control" required placeholder="e.g. Rahul Sharma" />
                    </div>

                    <div class="form-group">
                        <label for="mobile_number">Mobile Number * <small style="color: var(--text-muted); font-weight: normal;">(10-digit number)</small></label>
                        <input type="tel" id="mobile_number" name="mobile_number" class="form-control" required pattern="[0-9]{10}" maxlength="10" placeholder="e.g. 9876543210" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1.5fr; gap: 1.5rem;" class="form-grid">
                    <div class="form-group">
                        <label for="block_wing">Block / Wing *</label>
                        <select id="block_wing" name="block_wing" class="form-control" required>
                            <option value="" disabled selected>Select Block...</option>
                            <option value="Tower A">Tower A</option>
                            <option value="Tower B">Tower B</option>
                            <option value="Tower C">Tower C</option>
                            <option value="Tower D">Tower D</option>
                            <option value="Tower E">Tower E</option>
                            <option value="Tower F">Tower F</option>
                            <option value="Clubhouse">Clubhouse / Common Area</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="flat_number">Flat Number *</label>
                        <input type="text" id="flat_number" name="flat_number" class="form-control" required placeholder="e.g. Flat 402" />
                    </div>

                    <div class="form-group">
                        <label for="email">Email Address <span style="color: var(--text-muted); font-weight: normal;">(Optional)</span></label>
                        <input type="email" id="email" name="email" class="form-control" placeholder="e.g. rahul.sharma@gmail.com" />
                    </div>
                </div>

                <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--primary); margin-top: 1.5rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-light); padding-bottom: 0.5rem;">
                    2. Complaint Details
                </h3>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;" class="form-grid">
                    <div class="form-group">
                        <label for="category">Maintenance Category *</label>
                        <select id="category" name="category" class="form-control" required>
                            <option value="" disabled selected>Select category...</option>
                            <% [
                                'Water Leakage',
                                'Electrical Issue',
                                'Lift Problem',
                                'Parking Issue',
                                'Security Complaint',
                                'Housekeeping',
                                'Garbage Collection',
                                'Water Supply',
                                'Plumbing',
                                'Garden Maintenance',
                                'Street Lighting',
                                'Other'
                            ].forEach(cat => { %>
                            <option value="<%= cat %>"><%= cat %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="title">Complaint Title *</label>
                        <input type="text" id="title" name="title" class="form-control" required maxlength="150" placeholder="e.g. Master Bathroom Pipe Seepage" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Priority Level *</label>
                    <div class="priority-options">
                        <label class="priority-option priority-low-opt">
                            <input type="radio" name="priority" value="Low" required />
                            <span><i class="fas fa-arrow-down"></i> Low Priority</span>
                        </label>
                        <label class="priority-option priority-medium-opt">
                            <input type="radio" name="priority" value="Medium" checked />
                            <span><i class="fas fa-minus"></i> Medium Priority</span>
                        </label>
                        <label class="priority-option priority-high-opt">
                            <input type="radio" name="priority" value="High" />
                            <span><i class="fas fa-arrow-up"></i> High Priority</span>
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label for="description">Complaint Description * <small style="color: var(--text-muted); font-weight: normal;">(Minimum 20 characters)</small></label>
                    <textarea id="description" name="description" class="form-control" rows="5" required minlength="20" maxlength="2000" placeholder="Please describe the issue in detail (at least 20 characters)..."></textarea>
                    <small style="color: var(--text-muted); font-size: 0.78rem; display: block; margin-top: 4px;"><span id="descCount">0</span>/2000 characters</small>
                </div>

                <div class="form-group">
                    <label>Attach Image <span style="color: var(--text-muted); font-weight: normal;">(Optional photo proof)</span></label>
                    <div class="file-upload-area" id="fileUploadArea">
                        <input type="file" id="image" name="image" accept="image/*" class="file-input" />
                        <div class="file-upload-label" id="fileLabel">
                            <i class="fas fa-cloud-upload-alt"></i>
                            <p>Click or drag & drop photo of issue</p>
                            <span>Supports JPG, PNG, WEBP (Max 5MB)</span>
                        </div>
                        <img id="imagePreview" class="image-preview" style="display:none" alt="Uploaded Image Preview" />
                    </div>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem;">
                    <a href="/" class="btn btn-light"><i class="fas fa-times"></i> Cancel</a>
                    <button type="submit" class="btn btn-primary" id="submitBtn" style="padding: 0.85rem 2rem; font-size: 1.05rem;">
                        <i class="fas fa-paper-plane"></i> Submit Complaint
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<script src="/js/main.js"></script>
<script src="/js/complaints.js"></script>
</body>
</html>
