<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resident Dashboard – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="dashboard-body">

<%- include('../partials/sidebar', { activePage: 'dashboard' }) %>

<div class="main-content" id="mainContent">
    <div class="topbar">
        <div class="topbar-left">
            <h1><i class="fas fa-building" style="color: var(--primary);"></i> Resident Dashboard</h1>
            <p>Welcome back, <strong><%= user.full_name %></strong> — manage your apartment maintenance tickets</p>
        </div>
        <div class="topbar-right">
            <a href="/complaints/new" class="btn btn-primary"><i class="fas fa-plus-circle"></i> Register Complaint</a>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #D1FAE5; color: #059669; border: 1px solid #A7F3D0; padding: 1rem 1.25rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <i class="fas fa-check-circle" style="margin-right: 6px;"></i> <%= success %>
    </div>
    <% } %>

    <!-- Resident Stats Counter Grid -->
    <div class="stats-grid-7">
        <div class="stat-card stat-total">
            <div class="stat-icon"><i class="fas fa-file-alt"></i></div>
            <div class="stat-info">
                <h3><%= stats.total || 0 %></h3>
                <p>Total Complaints</p>
            </div>
        </div>
        
        <div class="stat-card stat-pending">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-info">
                <h3><%= stats.pending || 0 %></h3>
                <p>Pending</p>
            </div>
        </div>

        <div class="stat-card stat-progress">
            <div class="stat-icon"><i class="fas fa-tools"></i></div>
            <div class="stat-info">
                <h3><%= stats.in_progress || 0 %></h3>
                <p>In Progress</p>
            </div>
        </div>

        <div class="stat-card stat-resolved">
            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
            <div class="stat-info">
                <h3><%= stats.resolved || 0 %></h3>
                <p>Resolved</p>
            </div>
        </div>

        <div class="stat-card stat-rejected">
            <div class="stat-icon"><i class="fas fa-times-circle"></i></div>
            <div class="stat-info">
                <h3><%= stats.rejected || 0 %></h3>
                <p>Rejected</p>
            </div>
        </div>
    </div>

    <!-- Recent Complaints Card -->
    <div class="table-card">
        <div class="table-header">
            <h3><i class="fas fa-history" style="color: var(--primary); margin-right: 8px;"></i> Recent Maintenance Requests</h3>
            <a href="/complaints" class="btn btn-light" style="padding: 0.4rem 0.9rem; font-size: 0.85rem;">View All Requests <i class="fas fa-arrow-right" style="margin-left: 4px;"></i></a>
        </div>
        
        <% if (!recentComplaints || recentComplaints.length === 0) { %>
        <div style="padding: 3rem; text-align: center; color: var(--text-muted);">
            <i class="fas fa-folder-open" style="font-size: 3rem; margin-bottom: 1rem; color: var(--border-light);"></i>
            <h4>No maintenance requests logged yet</h4>
            <p style="font-size: 0.9rem; margin-top: 0.25rem;"><a href="/complaints/new" style="color: var(--primary); font-weight: 700;">Submit your first maintenance complaint</a></p>
        </div>
        <% } else { %>
        <div style="overflow-x: auto;">
            <table class="custom-table">
                <thead>
                    <tr>
                        <th>Ticket ID</th>
                        <th>Complaint Title</th>
                        <th>Category</th>
                        <th>Location / Flat</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Date Submitted</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% recentComplaints.forEach(c => { %>
                    <tr>
                        <td><strong style="color: var(--primary);"><%= c.complaint_id %></strong></td>
                        <td><strong><%= c.title %></strong></td>
                        <td><span style="font-size: 0.85rem; font-weight: 600; color: var(--text-body);"><%= c.category %></span></td>
                        <td><%= c.department %></td>
                        <td>
                            <span class="badge badge-priority-<%= c.priority.toLowerCase() %>"><%= c.priority %></span>
                        </td>
                        <td>
                            <span class="badge badge-<%= c.status.toLowerCase().replace(' ', '-') %>"><%= c.status %></span>
                        </td>
                        <td><%= new Date(c.created_at).toLocaleDateString('en-IN') %></td>
                        <td>
                            <a href="/complaints/<%= c.id %>" class="btn btn-light" style="padding: 0.3rem 0.7rem; font-size: 0.8rem;">
                                <i class="fas fa-eye"></i> Details
                            </a>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
        <% } %>
    </div>
</div>

<script src="/js/main.js"></script>
</body>
</html>
