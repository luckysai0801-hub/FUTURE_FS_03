<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Skyline Residency – Smart Apartment Complaint & Maintenance Portal</title>
    <meta name="description" content="Commercial-grade smart apartment maintenance and complaint management portal for Skyline Residency community. Register, track, and manage residential requests 24/7 without login.">
    <meta name="keywords" content="Skyline Residency, Apartment Maintenance, Complaint Management, Society Portal, Residential Maintenance">
    
    <!-- Open Graph Metadata -->
    <meta property="og:title" content="Skyline Residency – Smart Apartment Complaint & Maintenance Portal">
    <meta property="og:description" content="Submit maintenance requests, track progress in real-time with Complaint ID, and enjoy hassle-free residential community living.">
    <meta property="og:type" content="website">

    <!-- Favicon -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🏢</text></svg>">

    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    
    <!-- Stylesheets -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<%- include('partials/navbar') %>

<!-- Flash Notifications -->
<% if (typeof success !== 'undefined' && success) { %>
<div class="container" style="margin-top: 1rem;">
    <div style="background: #D1FAE5; color: #059669; border: 1px solid #A7F3D0; padding: 1rem 1.5rem; border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
        <div><i class="fas fa-check-circle" style="margin-right: 8px;"></i> <%= success %></div>
        <button onclick="this.parentElement.remove()" style="background: none; border: none; cursor: pointer; color: #059669;"><i class="fas fa-times"></i></button>
    </div>
</div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
<div class="container" style="margin-top: 1rem;">
    <div style="background: #FEE2E2; color: #DC2626; border: 1px solid #FECACA; padding: 1rem 1.5rem; border-radius: var(--radius-sm); display: flex; justify-content: space-between; align-items: center;">
        <div><i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i> <%= error %></div>
        <button onclick="this.parentElement.remove()" style="background: none; border: none; cursor: pointer; color: #DC2626;"><i class="fas fa-times"></i></button>
    </div>
</div>
<% } %>

<!-- 1. HERO SECTION -->
<section class="hero-section">
    <div class="container">
        <div class="hero-grid">
            <div class="hero-content">
                <div class="hero-badge">
                    <i class="fas fa-shield-alt"></i> Public Resident Maintenance Gateway (No Login Required)
                </div>
                <h1>
                    Smart Complaint Management for <span>Modern Apartment</span> Communities
                </h1>
                <p class="hero-subtitle">
                    Submit maintenance requests, track progress in real-time, and enjoy hassle-free community living with instant Complaint ID dispatch.
                </p>
                <div class="hero-buttons">
                    <a href="/complaints/new" class="btn btn-primary" style="font-size: 1.05rem; padding: 0.85rem 1.8rem;">
                        <i class="fas fa-plus-circle"></i> Register Complaint
                    </a>
                    <a href="/track" class="btn btn-secondary" style="font-size: 1.05rem; padding: 0.85rem 1.8rem;">
                        <i class="fas fa-search-location"></i> Track Complaint
                    </a>
                </div>
            </div>
            
            <div class="hero-card">
                <div class="hero-card-icon">
                    <i class="fas fa-tools"></i>
                </div>
                <h3 style="font-size: 1.4rem; margin-bottom: 0.75rem;">Instant Ticket Tracking</h3>
                <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
                    Submit your issue freely and receive an automated Complaint ID (e.g. CMP-2026-000145) for 24/7 status tracking.
                </p>
                <div style="background: var(--bg); padding: 1rem; border-radius: var(--radius-sm); border: 1px solid var(--border-light);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <strong style="font-size: 0.88rem; color: var(--primary);"><i class="fas fa-ticket-alt"></i> CMP-2026-000102 – Elevator Fix</strong>
                        <span class="badge badge-in-progress">In Progress</span>
                    </div>
                    <p style="font-size: 0.82rem; color: var(--text-muted); margin: 0;">Assigned to Senior Lift Technician (Otis Maintenance)</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2. ABOUT SECTION -->
<section id="about" style="padding: 5rem 0; background: #FFFFFF;">
    <div class="container">
        <div class="section-title">
            <h2>About Skyline Residency</h2>
            <p>A luxury gated residential community engineered for comfort, safety, and modern living.</p>
        </div>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center;">
            <div>
                <h3 style="font-size: 1.8rem; margin-bottom: 1rem; color: var(--primary);">Next-Gen Apartment Management</h3>
                <p style="margin-bottom: 1.25rem; line-height: 1.7;">
                    Skyline Residency is home to over 500 premium residential units across 6 towers. To ensure high standards of living, our Smart Maintenance Portal allows public ticket registration without account creation.
                </p>
                <p style="margin-bottom: 1.5rem; line-height: 1.7;">
                    Whether it's plumbing, electrical, lift, or security concerns, residents can log requests online in seconds and track progress using their unique Complaint ID.
                </p>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div style="padding: 1rem; background: var(--bg); border-radius: var(--radius-sm); border-left: 4px solid var(--primary);">
                        <strong style="color: var(--primary); font-size: 1.1rem; display: block;">500+ Units</strong>
                        <span style="font-size: 0.85rem; color: var(--text-muted);">Connected Homes</span>
                    </div>
                    <div style="padding: 1rem; background: var(--bg); border-radius: var(--radius-sm); border-left: 4px solid var(--secondary);">
                        <strong style="color: var(--secondary); font-size: 1.1rem; display: block;">< 24 Hours</strong>
                        <span style="font-size: 0.85rem; color: var(--text-muted);">Avg. Turnaround</span>
                    </div>
                </div>
            </div>
            
            <div style="background: var(--primary-light); padding: 2.5rem; border-radius: var(--radius-lg); border: 1px solid rgba(30, 58, 138, 0.15);">
                <h4 style="font-size: 1.3rem; margin-bottom: 1rem; color: var(--primary);"><i class="fas fa-check-double"></i> Why Choose Our Portal?</h4>
                <ul style="display: flex; flex-direction: column; gap: 1rem;">
                    <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                        <i class="fas fa-check-circle" style="color: var(--secondary); font-size: 1.2rem; margin-top: 2px;"></i>
                        <div><strong>Zero Account Friction:</strong> Submit complaints immediately without registration or login passwords.</div>
                    </li>
                    <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                        <i class="fas fa-check-circle" style="color: var(--secondary); font-size: 1.2rem; margin-top: 2px;"></i>
                        <div><strong>Real-Time Complaint Tracking:</strong> Search your unique Complaint ID anytime for technician status and resolution notes.</div>
                    </li>
                    <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                        <i class="fas fa-check-circle" style="color: var(--secondary); font-size: 1.2rem; margin-top: 2px;"></i>
                        <div><strong>Photographic Evidence:</strong> Attach photos directly to your maintenance requests.</div>
                    </li>
                    <li style="display: flex; gap: 0.75rem; align-items: flex-start;">
                        <i class="fas fa-check-circle" style="color: var(--secondary); font-size: 1.2rem; margin-top: 2px;"></i>
                        <div><strong>Transparent Oversight:</strong> Society Manager reviews and signs off every ticket.</div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- 3. SERVICES SECTION -->
<section id="services" style="padding: 5rem 0; background: var(--bg);">
    <div class="container">
        <div class="section-title">
            <h2>Our Core Services</h2>
            <p>Designed for seamless interaction between residents, society managers, and facility technicians.</p>
        </div>
        
        <div class="grid-3">
            <div class="card">
                <div class="category-icon" style="margin-left: 0;"><i class="fas fa-file-signature"></i></div>
                <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Complaint Registration</h3>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Categorized issue submission with Full Name, Flat Number, Mobile, Block/Wing, Priority, Description, and photo uploads.</p>
            </div>
            
            <div class="card">
                <div class="category-icon" style="margin-left: 0;"><i class="fas fa-route"></i></div>
                <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Complaint Tracking</h3>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Search by Complaint ID (e.g. CMP-2026-000145) anytime to inspect assigned staff, status timeline, and resolution remarks.</p>
            </div>
            
            <div class="card">
                <div class="category-icon" style="margin-left: 0;"><i class="fas fa-user-cog"></i></div>
                <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Maintenance Updates</h3>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Automated status changes (Pending, In Progress, Resolved, Rejected) logged transparently in an audit trail.</p>
            </div>
            
            <div class="card">
                <div class="category-icon" style="margin-left: 0;"><i class="fas fa-phone-alt"></i></div>
                <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Emergency Contacts</h3>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Instant access to 24/7 plumbers, electricians, lift technicians, and main security gate control desk numbers.</p>
            </div>
            
            <div class="card">
                <div class="category-icon" style="margin-left: 0;"><i class="fas fa-bell"></i></div>
                <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Live Ticket Lookup</h3>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Anyone can check complaint progress using their Complaint ID without logging in.</p>
            </div>
            
            <div class="card">
                <div class="category-icon" style="margin-left: 0;"><i class="fas fa-bullhorn"></i></div>
                <h3 style="font-size: 1.2rem; margin-bottom: 0.5rem;">Announcements</h3>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Stay informed about scheduled power maintenance, water tank cleaning, pest control, and society general body meetings.</p>
            </div>
        </div>
    </div>
</section>

<!-- 4. COMPLAINT CATEGORIES -->
<section style="padding: 5rem 0; background: #FFFFFF;">
    <div class="container">
        <div class="section-title">
            <h2>Maintenance Categories</h2>
            <p>Select from 12 specialized categories to ensure your request reaches the right technician immediately.</p>
        </div>
        
        <div class="grid-4">
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-tint"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Water Leakage</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Ceilings & Pipes</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-bolt"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Electrical Issue</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Wiring & Breakers</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-elevator"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Lift Problem</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Elevator Service</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-car"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Parking Issue</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Slots & Parking</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-shield-alt"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Security Complaint</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Gates & Patrol</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-broom"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Housekeeping</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Corridors & Lobby</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-trash-alt"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Garbage Collection</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Doorstep Trash</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-water"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Water Supply</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Tank & Pressure</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-faucet"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Plumbing</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Faucets & Drains</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-seedling"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Garden Maintenance</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Parks & Lawns</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-lightbulb"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Street Lighting</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">Pathway Lights</span>
            </div>
            <div class="category-card">
                <div class="category-icon"><i class="fas fa-ellipsis-h"></i></div>
                <h4 style="font-size: 1rem; margin-bottom: 0.25rem;">Other</h4>
                <span style="font-size: 0.8rem; color: var(--text-muted);">General Requests</span>
            </div>
        </div>
    </div>
</section>

<!-- 5. HOW IT WORKS -->
<section style="padding: 5rem 0; background: var(--bg);">
    <div class="container">
        <div class="section-title">
            <h2>How It Works</h2>
            <p>5 simple steps from logging your issue to complete verification.</p>
        </div>
        
        <div class="steps-wrapper">
            <div class="step-card">
                <div class="step-number">1</div>
                <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Register Complaint</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted);">Resident fills out ticket online and receives a unique Complaint ID.</p>
            </div>
            
            <div class="step-card">
                <div class="step-number">2</div>
                <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Admin Notification</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted);">Society Manager receives ticket alert on control dashboard.</p>
            </div>
            
            <div class="step-card">
                <div class="step-number">3</div>
                <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Team Assignment</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted);">Maintenance staff or external vendor dispatched.</p>
            </div>
            
            <div class="step-card">
                <div class="step-number">4</div>
                <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Issue Resolution</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted);">Technician completes work and logs resolution notes.</p>
            </div>
            
            <div class="step-card">
                <div class="step-number">5</div>
                <h4 style="font-size: 1.05rem; margin-bottom: 0.5rem;">Track Progress</h4>
                <p style="font-size: 0.85rem; color: var(--text-muted);">Resident tracks status live using Complaint ID.</p>
            </div>
        </div>
    </div>
</section>

<!-- 6. RESIDENT TESTIMONIALS -->
<section style="padding: 5rem 0; background: #FFFFFF;">
    <div class="container">
        <div class="section-title">
            <h2>Resident Testimonials</h2>
            <p>See what our residents say about living at Skyline Residency.</p>
        </div>
        
        <div class="grid-3">
            <div class="testimonial-card">
                <div style="color: var(--accent-gold); margin-bottom: 1rem;"><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i><i class="fas fa-star"></i></div>
                <p style="font-size: 0.95rem; font-style: italic; color: var(--text-body);">"I logged a pipe leakage issue on the website without needing to log in. Got my Complaint ID immediately and the plumber arrived by morning!"</p>
