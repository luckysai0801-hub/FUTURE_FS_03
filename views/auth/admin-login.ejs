<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Society Manager Login – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/auth.css">
</head>
<body class="auth-body">
<div class="auth-container">
    <div class="auth-left admin-auth-left">
        <div class="auth-brand"><i class="fas fa-building"></i> Skyline Admin</div>
        <div>
            <div class="admin-badge"><i class="fas fa-lock"></i> Authorized Staff Only</div>
            <h1>Society Management Panel</h1>
            <p>Access the central administration control dashboard to review resident complaints, dispatch technicians, and generate maintenance reports.</p>
            <div class="auth-features">
                <div class="auth-feature"><i class="fas fa-check-circle"></i> Central Maintenance Dispatch</div>
                <div class="auth-feature"><i class="fas fa-check-circle"></i> Staff Work Order Assignment</div>
                <div class="auth-feature"><i class="fas fa-check-circle"></i> Resident Directory Oversight</div>
                <div class="auth-feature"><i class="fas fa-check-circle"></i> PDF & CSV Audit Exports</div>
            </div>
        </div>
        <p style="font-size: 0.8rem; opacity: 0.7; margin: 0;">&copy; Skyline Residency Management Committee</p>
    </div>
    
    <div class="auth-right">
        <div class="auth-form-container">
            <div class="auth-header">
                <h2>Society Manager Sign In</h2>
                <p>Enter your management admin credentials</p>
            </div>
            
            <% if (typeof error !== 'undefined' && error) { %>
            <div style="background: #FEE2E2; color: #DC2626; padding: 0.75rem 1rem; border-radius: var(--radius-sm); font-size: 0.88rem; margin-bottom: 1.25rem;">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
            <% } %>

            <form action="/admin/login" method="POST">
                <div class="form-group">
                    <label for="email">Admin Email</label>
                    <input type="email" id="email" name="email" class="form-control" required placeholder="admin@skylineresidency.com" />
                </div>
                
                <div class="form-group">
                    <label for="password">Admin Password</label>
                    <input type="password" id="password" name="password" class="form-control" required placeholder="••••••••" />
                </div>
                
                <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.85rem; background: #0F172A;">
                    <i class="fas fa-user-shield"></i> Sign In to Admin Panel
                </button>
            </form>
            
            <div style="text-align: center; margin-top: 1.75rem; border-top: 1px solid var(--border-light); padding-top: 1.25rem;">
                <a href="/login" style="font-size: 0.85rem; color: var(--primary); font-weight: 700;">
                    <i class="fas fa-user"></i> Resident Portal Sign In
                </a>
            </div>
        </div>
    </div>
</div>
</body>
</html>
