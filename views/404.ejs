<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Page Not Found – Skyline Residency</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body { display:flex; align-items:center; justify-content:center; min-height:100vh; background: #F8FAFC; text-align:center; font-family:'Plus Jakarta Sans',sans-serif; }
        .not-found { padding: 3rem; background:#FFFFFF; border-radius:var(--radius-lg); box-shadow:var(--shadow-lg); border:1px solid var(--border-light); max-width:480px; width:90%; }
        .not-found .icon { font-size: 4rem; color: var(--primary); margin-bottom: 1rem; }
        .not-found h1 { font-size: 3.5rem; color: var(--text-main); margin: 0; font-weight:800; }
        .not-found h2 { font-size: 1.35rem; color: var(--text-body); font-weight: 700; margin-bottom:0.5rem; }
        .not-found p { color: var(--text-muted); margin-bottom: 2rem; font-size:0.92rem; }
    </style>
</head>
<body>
    <div class="not-found">
        <div class="icon"><i class="fas fa-building-circle-exclamation"></i></div>
        <h1>404</h1>
        <h2>Page Not Found</h2>
        <p>The requested Skyline Residency portal page could not be found or has been moved.</p>
        <a href="/" class="btn btn-primary"><i class="fas fa-home"></i> Back to Skyline Home</a>
    </div>
</body>
</html>
